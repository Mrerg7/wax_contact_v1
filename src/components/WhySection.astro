---
const reasons = [
  {
    title: 'Truly global positioning',
    body: '"Wax" is understood across languages and cultures — from New York to Dubai, London to Tokyo — without geographic limits.',
  },
  {
    title: 'The power of .contact',
    body: 'The TLD implies connection, inquiry, and professionalism. Ideal for booking platforms, directories, lead engines, and trusted service networks.',
  },
  {
    title: 'Timeless cultural relevance',
    body: 'Hair removal has been practiced across cultures since the Neolithic era. This name carries authentic, enduring resonance.',
  },
  {
    title: 'Massive addressable market',
    body: 'The global hair removal products and services market exceeds $14–32B and keeps growing. Waxing is a recurring professional treatment worldwide.',
  },
  {
    title: 'Extremely versatile brand',
    body: 'Works for salon chains, booking apps, product lines, training networks, media brands, or tech platforms connecting clients and estheticians.',
  },
  {
    title: 'Scarce and defensible',
    body: 'Short, meaningful .contact domains with universal service keywords are exceptionally rare — a one-of-a-kind digital asset.',
  },
];
---

<section id="why" class="max-w-6xl mx-auto px-4 sm:px-6 py-16 sm:py-20 md:py-24">
  <div class="max-w-2xl mb-12 sm:mb-14">
    <p class="eyebrow mb-3">Strategic asset</p>
    <h2 class="section-header">Why wax.contact commands premium value</h2>
    <p class="mt-4 text-[var(--color-muted)] text-lg leading-relaxed">
      Universal relevance, modern branding, and deep cultural resonance in one short name.
    </p>
  </div>

  <div class="border-b border-[var(--color-line)]">
    {reasons.map((reason, i) => (
      <article class="feature-row grid md:grid-cols-12 gap-3 md:gap-8 py-6 sm:py-7">
        <div class="md:col-span-1 text-sm font-semibold text-[var(--color-sand)] tabular-nums pt-1">
          {String(i + 1).padStart(2, '0')}
        </div>
        <h3 class="md:col-span-4 font-display text-xl sm:text-2xl tracking-tight text-[var(--color-ink)]">
          {reason.title}
        </h3>
        <p class="md:col-span-7 text-[var(--color-muted)] leading-relaxed text-base sm:text-lg">
          {reason.body}
        </p>
      </article>
    ))}
  </div>
</section>
