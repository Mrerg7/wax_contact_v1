---
import AcquisitionCTA from './AcquisitionCTA.astro';
import { SITE } from '../config/site';

const navLinks = [
  { href: '#why', label: 'Why This Domain' },
  { href: '#market', label: 'Market' },
  { href: '#use-cases', label: 'Use Cases' },
  { href: '#faq', label: 'FAQ' },
];
---

<header id="nav" data-scrolled="false" class="site-nav fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3.5 sm:py-4 flex items-center justify-between gap-3">
    <a href="/" class="flex items-center gap-x-2.5 group min-w-0" aria-label="wax.contact home">
      <span class="w-9 h-9 rounded-lg bg-[var(--color-jade)] text-white font-display text-lg flex items-center justify-center shrink-0">
        W
      </span>
      <span class="font-display text-xl sm:text-2xl tracking-tight truncate">
        <span class="nav-brand-main">wax</span><span class="nav-brand-accent">.contact</span>
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-x-7 text-sm font-medium" aria-label="Primary">
      {navLinks.map((link) => (
        <a href={link.href} class="nav-link transition-colors">
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-x-2 sm:gap-x-3 shrink-0">
      <span class="hidden md:inline text-sm font-semibold tabular-nums nav-price">
        {SITE.priceFormatted}
      </span>
      <AcquisitionCTA
        variant="primary"
        size="sm"
        label="Buy Now"
        class="!rounded-lg"
      />
      <button
        id="menu-toggle"
        type="button"
        class="nav-menu-btn lg:hidden inline-flex items-center justify-center min-h-11 min-w-11 rounded-lg border transition-colors"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open navigation menu"
      >
        <svg id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd" />
        </svg>
        <svg id="menu-icon-close" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 hidden" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="nav-mobile-panel lg:hidden hidden border-t backdrop-blur-md">
    <nav class="max-w-6xl mx-auto px-4 sm:px-6 py-3 flex flex-col gap-1" aria-label="Mobile">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-link min-h-11 flex items-center px-3 rounded-lg font-medium transition-colors"
        >
          {link.label}
        </a>
      ))}
      <a
        href="#acquire"
        class="mobile-nav-link mobile-nav-cta min-h-11 flex items-center px-3 rounded-lg font-semibold transition-colors"
      >
        Make an Offer — {SITE.priceFormatted}
      </a>
    </nav>
  </div>
</header>

<script>
  function initNavbar() {
    const nav = document.getElementById('nav');
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    if (!nav) return;

    const onScroll = () => {
      nav.dataset.scrolled = window.scrollY > 40 ? 'true' : 'false';
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    if (!menuToggle || !mobileMenu || !iconOpen || !iconClose) return;

    const setMenuOpen = (open: boolean) => {
      menuToggle.setAttribute('aria-expanded', String(open));
      menuToggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
      mobileMenu.classList.toggle('hidden', !open);
      iconOpen.classList.toggle('hidden', open);
      iconClose.classList.toggle('hidden', !open);
    };

    menuToggle.addEventListener('click', () => {
      const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
      setMenuOpen(!isOpen);
    });

    mobileMenu.querySelectorAll('.mobile-nav-link').forEach((link) => {
      link.addEventListener('click', () => setMenuOpen(false));
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024) setMenuOpen(false);
    });
  }

  initNavbar();
  document.addEventListener('astro:page-load', initNavbar);
</script>
