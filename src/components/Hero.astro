---
import { CF_STREAM, SITE } from '../config/site';
import AcquisitionCTA from './AcquisitionCTA.astro';
---

<section class="relative min-h-[100svh] flex items-end sm:items-center overflow-hidden">
  <!-- Full-bleed Stream video background -->
  <div class="hero-stream" aria-hidden="true">
    <div class="hero-stream__frame">
      <iframe
        src={CF_STREAM.iframeSrc}
        title=""
        loading="eager"
        class="hero-stream__iframe"
        allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;"
        tabindex="-1"
      ></iframe>
    </div>
    <div class="absolute inset-0 hero-veil"></div>
  </div>

  <div class="relative z-10 w-full max-w-6xl mx-auto px-4 sm:px-6 pt-28 pb-28 sm:pt-32 sm:pb-24">
    <div class="max-w-3xl">
      <div class="reveal inline-flex items-center gap-2 mb-6 rounded-full border border-white/20 bg-white/10 px-3.5 py-1.5 backdrop-blur-sm">
        <span class="live-dot h-2 w-2 rounded-full bg-[#5ddea8]"></span>
        <span class="text-[11px] sm:text-xs font-semibold tracking-[0.14em] uppercase text-white/90">
          For sale · {SITE.priceFormatted}
        </span>
      </div>

      <h1 class="reveal reveal-delay-1 domain-name text-white mb-5 whitespace-nowrap">
        wax<span class="text-[#7fd4bd]">.contact</span>
      </h1>

      <p class="reveal reveal-delay-2 text-xl sm:text-2xl md:text-3xl font-medium text-white/90 tracking-tight max-w-xl mb-4">
        The global name for professional hair removal.
      </p>

      <p class="reveal reveal-delay-3 text-base sm:text-lg text-white/65 max-w-lg mb-8 sm:mb-10 leading-relaxed">
        A scarce .contact domain that positions any waxing brand, booking platform, or salon group as the trusted worldwide connection.
      </p>

      <div class="reveal reveal-delay-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4">
        <AcquisitionCTA
          variant="primary"
          size="lg"
          label="Inquire to Acquire"
          class="!rounded-xl w-full sm:w-auto"
        />
        <a
          href="#acquire"
          class="btn-ghost inline-flex items-center justify-center min-h-14 px-8 rounded-xl text-lg w-full sm:w-auto"
        >
          View Asking Price
        </a>
      </div>

      <ul class="reveal reveal-delay-4 mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm text-white/55">
        <li class="flex items-center gap-1.5">
          <svg class="h-4 w-4 text-[#7fd4bd]" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          Direct owner sale
        </li>
        <li class="flex items-center gap-1.5">
          <svg class="h-4 w-4 text-[#7fd4bd]" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          Escrow available
        </li>
        <li class="flex items-center gap-1.5">
          <svg class="h-4 w-4 text-[#7fd4bd]" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          Immediate transfer
        </li>
      </ul>
    </div>
  </div>
</section>
