---
import { CF_IMAGES } from '../config/site';
import AcquisitionCTA from './AcquisitionCTA.astro';
import CloudflareImage from './CloudflareImage.astro';
---

<section class="relative overflow-hidden warm-bg border-b border-warm">
  <!-- Hero Visual with looping magnifier -->
  <div class="w-full px-4 sm:px-6 pt-4 sm:pt-6 pb-4 sm:pb-6">
    <div
      class="hero-magnify max-w-screen-xl mx-auto rounded-2xl sm:rounded-3xl overflow-hidden border border-[#EDE4D7] shadow-lg shadow-[#2D5A4A]/5"
      style={`--hero-image: url('${CF_IMAGES.hero}')`}
    >
      <CloudflareImage
        src={CF_IMAGES.hero}
        alt="wax.contact — Premium global domain for professional hair removal and waxing services"
        width={1366}
        height={745}
        loading="eager"
        fetchpriority="high"
        sizes="(max-width: 640px) 100vw, (max-width: 1280px) 100vw, 1280px"
        class="hero-magnify__image w-full h-auto object-cover aspect-[4/3] sm:aspect-video"
      />
      <div class="hero-magnify__lens" aria-hidden="true">
        <span class="hero-magnify__rim"></span>
        <span class="hero-magnify__handle"></span>
      </div>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 pt-8 sm:pt-12 pb-16 sm:pb-20 md:pt-16 md:pb-24 text-center">
    <!-- Global Badge -->
    <div class="inline-flex items-center gap-x-2 mb-5 sm:mb-6 max-w-full">
      <div class="global-badge flex items-center gap-x-2 px-3 sm:px-5 py-1.5 rounded-2xl text-[11px] sm:text-sm font-bold tracking-[0.5px] sm:tracking-[1px]">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M4.083 9h1.946c.089-1.546.383-2.97.837-4.118A6.004 6.004 0 004.083 9zM10 2a8 8 0 100 16 8 8 0 000-16zm0 2c-.076 0-.232.032-.465.262-.238.234-.497.623-.737 1.182-.389.907-.673 2.142-.766 3.556h3.936c-.093-1.414-.377-2.649-.766-3.556-.24-.56-.5-.948-.737-1.182C10.232 4.032 10.076 4 10 4zm3.971 5c-.089-1.546-.383-2.97-.837-4.118A6.004 6.004 0 0115.917 9h-1.946zm-2.003 2H8.032c.093 1.414.377 2.649.766 3.556.24.56.5.948.737 1.182.233.23.389.262.465.262.076 0 .232-.032.465-.262.238-.234.498-.623.737-1.182.389-.907.673-2.142.766-3.556zm1.166 4.118c.454-1.147.748-2.572.837-4.118h1.946a6.004 6.004 0 01-2.783 4.118zm-6.268 0C6.412 13.97 6.118 12.546 6.03 11H4.083a6.004 6.004 0 002.783 4.118z" clip-rule="evenodd" />
        </svg>
        <span>GLOBAL • TIMELESS • UNIVERSAL</span>
      </div>
    </div>

    <h1 class="domain-name tracking-tighter mb-4">wax.contact</h1>

    <p class="max-w-2xl mx-auto text-xl sm:text-2xl md:text-3xl font-semibold tracking-tight text-forest mb-5 sm:mb-6">
      The global standard for<br class="hidden sm:block" /> professional hair removal.
    </p>

    <p class="max-w-lg mx-auto text-base sm:text-lg text-muted mb-8 sm:mb-10 px-2">
      A powerful, modern .contact domain that positions your brand as the trusted worldwide connection for expert waxing and epilation.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <AcquisitionCTA
        variant="primary"
        size="lg"
        label="Inquire to Acquire"
        class="!text-lg w-full sm:w-auto !shadow-lg !shadow-[#2D5A4A]/20 !rounded-3xl"
      />
      <a
        href="#why"
        class="inline-flex items-center justify-center w-full sm:w-auto min-h-12 px-8 py-4 border border-[#D4C9B8] hover:bg-white text-forest font-semibold text-lg rounded-3xl transition-all"
      >
        Explore the Opportunity
      </a>
    </div>

    <div class="mt-6 sm:mt-8 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-x-6 text-sm text-[#6B6B6B]">
      <div class="flex items-center gap-x-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-forest" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
        </svg>
        <span>Global brand potential</span>
      </div>
      <div class="flex items-center gap-x-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-forest" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
        </svg>
        <span>Modern .contact TLD</span>
      </div>
    </div>
  </div>

  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[800px] h-[1px] bg-gradient-to-r from-transparent via-[#D4C9B8] to-transparent"></div>
</section>

<script>
  function initHeroMagnifier() {
    const root = document.querySelector<HTMLElement>('.hero-magnify');
    const lens = document.querySelector<HTMLElement>('.hero-magnify__lens');
    if (!root || !lens) return;

    const syncBackground = () => {
      const { width, height } = root.getBoundingClientRect();
      if (width <= 0 || height <= 0) return;

      const zoom = window.matchMedia('(max-width: 640px)').matches ? 1.85 : 2.25;
      const lensSize = lens.offsetWidth || 120;
      const x = lens.offsetLeft;
      const y = lens.offsetTop;
      const cx = x + lensSize / 2;
      const cy = y + lensSize / 2;

      lens.style.backgroundSize = `${width * zoom}px ${height * zoom}px`;
      lens.style.backgroundPosition = `${-(cx * zoom - lensSize / 2)}px ${-(cy * zoom - lensSize / 2)}px`;
    };

    let frame = 0;
    const tick = () => {
      syncBackground();
      frame = requestAnimationFrame(tick);
    };

    const start = () => {
      cancelAnimationFrame(frame);
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        lens.style.animation = 'none';
        lens.style.left = '18%';
        lens.style.top = '28%';
        syncBackground();
        return;
      }
      frame = requestAnimationFrame(tick);
    };

    start();

    const resizeObserver = new ResizeObserver(() => syncBackground());
    resizeObserver.observe(root);

    window.addEventListener(
      'resize',
      () => {
        start();
      },
      { passive: true },
    );
  }

  initHeroMagnifier();
  document.addEventListener('astro:page-load', initHeroMagnifier);
</script>
