---
import { ACQUISITION_MAILTO, SITE } from '../config/site';
import AcquisitionCTA from './AcquisitionCTA.astro';
---

<footer id="acquire" class="surface-ink text-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16 sm:py-20 md:py-24">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3.5 py-1.5">
          <span class="live-dot h-2 w-2 rounded-full bg-[#5ddea8]"></span>
          <span class="text-[11px] font-semibold uppercase tracking-[0.16em] text-white/80">Available now</span>
        </div>

        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl tracking-tight leading-[1.05]">
          Acquire <span class="text-[#7fd4bd]">{SITE.name}</span>
        </h2>

        <p class="text-lg text-white/65 max-w-xl leading-relaxed">
          For domain investors, salon groups, booking platforms, and founders who want a category-defining name. Direct owner negotiation — no brokers.
        </p>

        <dl class="grid grid-cols-2 sm:grid-cols-4 gap-5 pt-2">
          <div>
            <dt class="text-[10px] uppercase tracking-[0.16em] text-white/40 mb-1">Characters</dt>
            <dd class="font-display text-2xl">11</dd>
          </div>
          <div>
            <dt class="text-[10px] uppercase tracking-[0.16em] text-white/40 mb-1">TLD</dt>
            <dd class="font-display text-2xl text-[#7fd4bd]">.contact</dd>
          </div>
          <div>
            <dt class="text-[10px] uppercase tracking-[0.16em] text-white/40 mb-1">Asking</dt>
            <dd class="font-display text-2xl">{SITE.priceFormatted}</dd>
          </div>
          <div>
            <dt class="text-[10px] uppercase tracking-[0.16em] text-white/40 mb-1">Transfer</dt>
            <dd class="font-display text-2xl text-[#7fd4bd]">Immediate</dd>
          </div>
        </dl>
      </div>

      <div class="lg:col-span-5 w-full">
        <form
          id="inquiry-form"
          class="rounded-2xl border border-white/10 bg-white/[0.04] p-5 sm:p-7 space-y-4"
          novalidate
        >
          <div>
            <label for="inquiry-name" class="block text-xs font-semibold uppercase tracking-[0.14em] text-white/50 mb-2">
              Your name
            </label>
            <input
              id="inquiry-name"
              name="name"
              type="text"
              required
              autocomplete="name"
              class="w-full min-h-12 rounded-xl border border-white/15 bg-white/5 px-4 text-white placeholder:text-white/35 focus:outline-none focus:ring-2 focus:ring-[#7fd4bd]/50"
              placeholder="Alex Rivera"
            />
          </div>
          <div>
            <label for="inquiry-email" class="block text-xs font-semibold uppercase tracking-[0.14em] text-white/50 mb-2">
              Email
            </label>
            <input
              id="inquiry-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              class="w-full min-h-12 rounded-xl border border-white/15 bg-white/5 px-4 text-white placeholder:text-white/35 focus:outline-none focus:ring-2 focus:ring-[#7fd4bd]/50"
              placeholder="you@company.com"
            />
          </div>
          <div>
            <label for="inquiry-offer" class="block text-xs font-semibold uppercase tracking-[0.14em] text-white/50 mb-2">
              Offer or message
            </label>
            <textarea
              id="inquiry-offer"
              name="message"
              rows="3"
              class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-3 text-white placeholder:text-white/35 focus:outline-none focus:ring-2 focus:ring-[#7fd4bd]/50 resize-y min-h-[5.5rem]"
              placeholder={`Interested at ${SITE.priceFormatted} — please share next steps.`}
            ></textarea>
          </div>
          <button
            type="submit"
            class="btn-primary w-full min-h-13 rounded-xl text-base font-semibold"
          >
            Send acquisition inquiry
          </button>
          <p class="text-center text-sm text-white/50">
            Or email
            <a href={ACQUISITION_MAILTO} class="text-[#7fd4bd] hover:underline">{SITE.email}</a>
            · response within 24 hours
          </p>
          <p id="inquiry-error" class="hidden text-sm text-red-300 text-center" role="alert"></p>
        </form>

        <div class="mt-5">
          <AcquisitionCTA
            variant="on-dark"
            size="md"
            label="Email owner directly"
            class="w-full !rounded-xl"
          />
        </div>
      </div>
    </div>

    <div class="mt-16 pt-8 border-t border-white/10 text-xs text-white/40 space-y-4">
      <p class="leading-relaxed max-w-4xl">
        This website is for informational purposes and presents wax.contact as a domain available for acquisition.
        Market figures are based on publicly available industry estimates as of {SITE.lastUpdated} and may change.
        Terms are subject to negotiation. Escrow recommended.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 sm:items-center sm:justify-between">
        <p>&copy; {new Date().getFullYear()} {SITE.name} — Premium domain for sale</p>
        <p class="flex flex-wrap gap-x-5 gap-y-1">
          <span>{SITE.location}</span>
          <span>Clean title</span>
          <span>Ready for transfer</span>
        </p>
      </div>
    </div>
  </div>
</footer>

<script>
  function initInquiryForm() {
    const form = document.getElementById('inquiry-form') as HTMLFormElement | null;
    const errorEl = document.getElementById('inquiry-error');
    if (!form) return;

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const name = String(data.get('name') || '').trim();
      const email = String(data.get('email') || '').trim();
      const message = String(data.get('message') || '').trim();

      if (!name || !email) {
        if (errorEl) {
          errorEl.textContent = 'Please add your name and email so we can reply.';
          errorEl.classList.remove('hidden');
        }
        return;
      }

      if (errorEl) errorEl.classList.add('hidden');

      const subject = encodeURIComponent('Acquisition Inquiry: wax.contact');
      const body = encodeURIComponent(
        `Hello,\n\nI am interested in acquiring wax.contact.\n\nName: ${name}\nEmail: ${email}\n\n${message || 'Please share details and next steps.'}\n\nBest regards,\n${name}`,
      );
      window.location.href = `mailto:sales@desertrich.com?subject=${subject}&body=${body}`;
    });
  }

  initInquiryForm();
  document.addEventListener('astro:page-load', initInquiryForm);
</script>
