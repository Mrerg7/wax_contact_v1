---
import { FAQ } from '../config/site';
---

<section id="faq" class="surface-mist border-y border-[var(--color-line)]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16 sm:py-20 md:py-24">
    <div class="max-w-2xl mb-10 sm:mb-12">
      <p class="eyebrow mb-3">FAQ</p>
      <h2 class="section-header">Buying wax.contact</h2>
      <p class="mt-4 text-[var(--color-muted)] text-lg">
        Straight answers for domain investors and brand founders.
      </p>
    </div>

    <div class="max-w-3xl divide-y divide-[var(--color-line)] border-y border-[var(--color-line)]">
      {FAQ.map((item) => (
        <details class="group py-5 sm:py-6">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-display text-lg sm:text-xl tracking-tight text-[var(--color-ink)]">
            <span>{item.question}</span>
            <span class="mt-1 shrink-0 text-[var(--color-jade)] transition-transform group-open:rotate-45" aria-hidden="true">
              <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
              </svg>
            </span>
          </summary>
          <p class="mt-3 pr-8 text-[var(--color-muted)] leading-relaxed">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
