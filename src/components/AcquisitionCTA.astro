---
import { ACQUISITION_MAILTO, SITE } from '../config/site';

interface Props {
  variant?: 'primary' | 'secondary' | 'on-dark' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  label?: string;
}

const {
  variant = 'primary',
  size = 'md',
  class: className = '',
  label = 'Acquire wax.contact',
} = Astro.props;

const sizeClasses = {
  sm: 'min-h-11 px-5 py-2.5 text-sm',
  md: 'min-h-12 px-8 py-3.5 text-base',
  lg: 'min-h-14 px-10 py-4 text-lg',
};

const variantClasses = {
  primary: 'btn-primary rounded-xl',
  secondary:
    'rounded-xl border border-[var(--color-line)] bg-white text-[var(--color-ink)] font-semibold hover:border-[var(--color-jade)] hover:text-[var(--color-jade)] transition-colors',
  'on-dark': 'btn-ghost rounded-xl',
  outline:
    'rounded-xl border-2 border-[var(--color-jade)] text-[var(--color-jade)] font-semibold hover:bg-[var(--color-jade)] hover:text-white transition-colors',
};

const classes = [
  'inline-flex items-center justify-center gap-x-2.5 transition-all',
  sizeClasses[size],
  variantClasses[variant],
  className,
]
  .filter(Boolean)
  .join(' ');
---

<a href={ACQUISITION_MAILTO} class={classes} aria-label={`${label} — email ${SITE.email}`}>
  <span>{label}</span>
  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
    <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
    <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
  </svg>
</a>
