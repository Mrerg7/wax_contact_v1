---
const useCases = [
  {
    title: 'Global booking platform',
    body: 'The worldwide hub where clients connect with vetted estheticians and salons across continents.',
  },
  {
    title: 'International salon group',
    body: 'Launch or scale a premium waxing brand with a name that travels effortlessly across markets.',
  },
  {
    title: 'Mobile / on-demand service',
    body: 'Expand city-by-city or country-by-country under one powerful concierge waxing name.',
  },
  {
    title: 'Training academy',
    body: 'Position as the global authority for professional waxing education, certification, and standards.',
  },
  {
    title: 'Premium product brand',
    body: 'Own a clean name for professional waxes, aftercare, tools, and devices in every market.',
  },
  {
    title: 'Media & community',
    body: 'Build the leading resource, magazine, podcast, or community around professional hair removal.',
  },
];
---

<section id="use-cases" class="max-w-6xl mx-auto px-4 sm:px-6 py-16 sm:py-20 md:py-24">
  <div class="max-w-2xl mb-12 sm:mb-14">
    <p class="eyebrow mb-3">Use cases</p>
    <h2 class="section-header">Built for worldwide ambition</h2>
    <p class="mt-4 text-[var(--color-muted)] text-lg leading-relaxed">
      One rare foundation that can support multiple high-value business models across borders.
    </p>
  </div>

  <div class="grid sm:grid-cols-2 gap-x-10 gap-y-10">
    {useCases.map((item, i) => (
      <article>
        <p class="text-xs font-semibold text-[var(--color-sand)] tabular-nums mb-2">
          {String(i + 1).padStart(2, '0')}
        </p>
        <h3 class="font-display text-xl sm:text-2xl tracking-tight mb-2">{item.title}</h3>
        <p class="text-[var(--color-muted)] leading-relaxed">{item.body}</p>
      </article>
    ))}
  </div>
</section>
