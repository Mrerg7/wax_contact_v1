{
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "wax-contact-v1",
	"main": "./src/worker.ts",
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": true,
		"html_handling": "force-trailing-slash"
	},
	"observability": {
		"enabled": true
	}
}
